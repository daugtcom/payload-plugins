# Copy to .env.local (gitignored). Never commit real keys.
DATABASE_URI=postgres://plugins:plugins@127.0.0.1:54330/plugins
PAYLOAD_SECRET=dev-only-change-me-dev-only-change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# Stripe TEST mode only (sk_test_...). Needed for the commerce spike.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# from `stripe listen --forward-to localhost:3100/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# Email (Resend). Without a key, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=
